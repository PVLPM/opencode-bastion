{
  "name": "opencode-bastion",
  "version": "0.1.0",
  "description": "Agent Fleet for OpenCode Desktop: live status, activity, cost and context of the orchestrator and its subagents.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PVLPM/opencode-bastion.git"
  },
  "homepage": "https://github.com/PVLPM/opencode-bastion#readme",
  "bugs": {
    "url": "https://github.com/PVLPM/opencode-bastion/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "subagents",
    "gui"
  ],
  "exports": {
    "./gui-experimental": {
      "default": "./dist/gui-experimental.cjs"
    }
  },
  "files": [
    "dist/gui-experimental.cjs",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "vite build",
    "demo:record": "node preview/record-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint -c .oxlintrc.json .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip",
    "dup:check": "jscpd src",
    "verify": "pnpm format:check && pnpm lint && pnpm knip && pnpm dup:check && pnpm typecheck && pnpm test && pnpm build",
    "pack:release-package": "node scripts/pack-release-package.mjs",
    "smoke:package": "node scripts/smoke-packed-package.mjs",
    "verify:package-contents": "node scripts/verify-package-contents.mjs",
    "verify:release-artifact": "node scripts/verify-release-artifact.mjs",
    "verify:release-package": "node scripts/verify-release-package.mjs",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "release:check": "pnpm verify && pnpm run verify:release-version",
    "prepublishOnly": "pnpm run release:check"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.4.0 <2.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@oxlint/plugins": "1.95.0",
    "@types/node": "^22.0.0",
    "happy-dom": "21.0.4",
    "jscpd": "5.4.3",
    "knip": "6.48.0",
    "oxlint": "1.95.0",
    "playwright": "1.59.0",
    "solid-js": "1.9.12",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.17",
    "vitest": "4.1.5"
  }
}
